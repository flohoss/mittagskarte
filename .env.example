# App config
TZ=Europe/Berlin

# Application metadata (synced to PocketBase Settings.Meta on startup)
APP_NAME=Mittagskarte
APP_URL=https://your-domain.tld

# Optional floating Buy Me a Coffee button, bottom right (hidden when empty)
BUYMEACOFFEE_URL=

# SMTP (required in production, synced to PocketBase Settings.SMTP on startup)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Mittagskarte
SMTP_SENDER_ADDRESS=noreply@your-domain.tld

# Initial superuser (created/updated on startup, then unset from environment)
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Telegram bot (optional; disabled when TELEGRAM_BOT_TOKEN is empty)
# Dev: long polling. Prod: webhook derived from APP_URL + TELEGRAM_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET=
